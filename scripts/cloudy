#!/usr/bin/env bash
# Steuerung von cloudy auf dem Raspberry Pi.
set -euo pipefail

DIR="${CLOUDY_DIR:-__CLOUDY_DIR__}"
REPO="${CLOUDY_REPO:-l8tenever/cloudy}"
BRANCH="${CLOUDY_BRANCH:-main}"
RAW="https://raw.githubusercontent.com/$REPO/$BRANCH"

# Platzhalter nie wörtlich ausschreiben – beim Installieren wird er sonst auch hier ersetzt.
PLACEHOLDER="__CLOUDY""_DIR__"
if [ ! -f "$DIR/docker-compose.yml" ]; then
  # Fehlerhaft installiert (Platzhalter nicht ersetzt) -> üblichen Ordner nehmen.
  for d in "$HOME/cloudy" "$PWD"; do
    if [ -f "$d/docker-compose.yml" ]; then DIR="$d"; break; fi
  done
fi
cd "$DIR" || { echo "cloudy-Ordner nicht gefunden. Aufruf z. B.: CLOUDY_DIR=~/cloudy cloudy update" >&2; exit 1; }
DOCKER="docker"
docker info >/dev/null 2>&1 || DOCKER="sudo docker"

compose() {
  local files=(-f docker-compose.yml)
  if [ -f data/docker-compose.slots.yml ]; then
    files+=(-f data/docker-compose.slots.yml)
  fi
  $DOCKER compose "${files[@]}" "$@"
}

set_env() {
  if grep -q "^$1=" .env; then
    sed -i "s|^$1=.*|$1=$2|" .env
  else
    echo "$1=$2" >> .env
  fi
}

# Frühere Versionen von "cloudy update" haben die Zeilen aus .env.example bei jedem Update erneut angehängt.
# Die späteren Kopien (Standardwerte) gewinnen dann -> nur die erste Zeile je Einstellung behalten.
dedupe_env() {
  [ -f .env ] || return 0
  awk '/^[A-Za-z_][A-Za-z0-9_]*=/ { k = $0; sub(/=.*/, "", k); if (seen[k]++) next } { print }' .env > .env.tmp
  if ! cmp -s .env .env.tmp; then
    cp .env .env.bak
    cat .env.tmp > .env
    echo "Doppelte Einträge in .env entfernt (Sicherung: .env.bak)."
  fi
  rm -f .env.tmp
}

# Profil-Datei der WARP-/VPN-Container sicherstellen (schreibt die App beim Start; sonst einmal kurz erzeugen).
ensure_slots() {
  mkdir -p data
  [ -f data/docker-compose.slots.yml ] && return 0
  $DOCKER compose run --rm --no-deps -e DNSMASQ_ENABLED=0 -e HTTPS_PORT=0 cloudy \
    python -c "import os; from app import slots; slots.ensure(os.environ.get('DATA_DIR','/data'))"
  [ -f data/docker-compose.slots.yml ]
}

# Neue/gelöschte WARP-/VPN-Profile im Dashboard -> Container automatisch anlegen/entfernen.
# systemd beobachtet data/docker-compose.slots.yml und ruft dann "cloudy slots" auf.
install_watcher() {
  command -v systemctl >/dev/null 2>&1 || return 0
  local self path_unit service_unit
  self="$(command -v cloudy || echo /usr/local/bin/cloudy)"
  path_unit="[Unit]
Description=cloudy: WARP-/VPN-Profile beobachten

[Path]
PathModified=$DIR/data/docker-compose.slots.yml
Unit=cloudy-slots.service

[Install]
WantedBy=multi-user.target
"
  service_unit="[Unit]
Description=cloudy: WARP-/VPN-Container an die Profile anpassen
After=docker.service

[Service]
Type=oneshot
Environment=CLOUDY_DIR=$DIR
Environment=CLOUDY_QUIET_WATCHER=1
ExecStart=$self slots
"
  if [ "$(cat /etc/systemd/system/cloudy-slots.path 2>/dev/null)" != "$path_unit" ]      || [ "$(cat /etc/systemd/system/cloudy-slots.service 2>/dev/null)" != "$service_unit" ]; then
    printf '%s' "$path_unit" | sudo tee /etc/systemd/system/cloudy-slots.path >/dev/null
    printf '%s' "$service_unit" | sudo tee /etc/systemd/system/cloudy-slots.service >/dev/null
    sudo systemctl daemon-reload
    sudo systemctl enable --now cloudy-slots.path >/dev/null 2>&1       && echo "Neue WARP-/VPN-Profile starten ab jetzt automatisch."
  fi
}

ask() {
  local answer
  read -r -p "$1 (j/n) " answer </dev/tty
  [[ "$answer" =~ ^[jJyY] ]]
}

usage() {
  cat <<EOF
cloudy update      Neueste Version von GitHub holen und neu starten
cloudy slots       WARP-/VPN-Container an die Profile aus dem Dashboard anpassen
cloudy dhcp an     Pi verteilt die IP-Adressen (vorher DHCP in der Fritzbox AUS!)
cloudy dhcp aus    Pi verteilt keine IP-Adressen mehr (danach DHCP in der Fritzbox wieder AN)
cloudy gateway an  Gesamter Datenverkehr läuft über den Pi und wird gemessen (braucht "dhcp an")
cloudy gateway aus Datenverkehr geht wieder direkt zur Fritzbox (DNS bleibt beim Pi)
cloudy ipv6 an     Pi verteilt IPv6 und schickt es durch WARP/VPN (vorher in der Fritzbox "Router Advertisement" AUS!)
cloudy ipv6 aus    Wieder nur IPv4 (der Standard)
cloudy status      Zeigt, ob alles läuft
cloudy logs        Live-Logs anzeigen (Strg+C zum Beenden), einzeln: cloudy logs warp1 / vpn1
cloudy restart     Neu starten
EOF
}

case "${1:-}" in
  update)
    # Zuerst diesen Befehl selbst erneuern – ältere Versionen kennen die WARP-/VPN-Profile (Overlay) nicht
    # und löschen die Container beim Update als "orphans".
    if [ -z "${CLOUDY_SELF_UPDATED:-}" ] && curl -fsSL "$RAW/scripts/cloudy" -o /tmp/cloudy-cli.new; then
      sed "s|$PLACEHOLDER|$DIR|" /tmp/cloudy-cli.new > /tmp/cloudy-cli
      self="$(command -v cloudy || echo /usr/local/bin/cloudy)"
      if ! cmp -s /tmp/cloudy-cli "$self"; then
        install -m 755 /tmp/cloudy-cli "$self" 2>/dev/null || sudo install -m 755 /tmp/cloudy-cli "$self"
        rm -f /tmp/cloudy-cli /tmp/cloudy-cli.new
        echo "Befehl cloudy aktualisiert."
        CLOUDY_SELF_UPDATED=1 exec "$self" update
      fi
      rm -f /tmp/cloudy-cli /tmp/cloudy-cli.new
    fi
    curl -fsSL "$RAW/docker-compose.yml" -o docker-compose.yml.new && mv docker-compose.yml.new docker-compose.yml
    dedupe_env
    # Neue Einstellungen aus .env.example ergänzen (vorhandene bleiben).
    if curl -fsSL "$RAW/.env.example" -o .env.example; then
      while IFS= read -r line; do
        case "$line" in ''|\#*) continue ;; esac
        grep -q "^${line%%=*}=" .env || echo "$line" >> .env
      done < .env.example
    fi
    # Frühere Standardeinstellung 8080 -> 80, damit http://cloudy.lan ohne Port geht.
    if grep -q "^DASHBOARD_PORT=8080$" .env; then
      set_env DASHBOARD_PORT 80
      echo "Dashboard-Port auf 80 gestellt (http://cloudy.lan)."
    fi
    $DOCKER compose pull
    ensure_slots || true
    if [ -f data/docker-compose.slots.yml ]; then
      compose pull
      compose up -d --remove-orphans
    else
      # Ohne Profil-Datei würde --remove-orphans die WARP-/VPN-Container löschen.
      echo "WARNUNG: data/docker-compose.slots.yml fehlt – WARP-/VPN-Container bleiben unverändert. Danach: cloudy slots"
      compose up -d
    fi
    install_watcher
    $DOCKER image prune -f >/dev/null
    echo "cloudy ist aktuell. Dashboard: http://$(grep '^LOCAL_NAME=' .env | cut -d= -f2)"
    ;;
  slots)
    if [ -n "${CLOUDY_QUIET_WATCHER:-}" ]; then
      # Vom Watcher aufgerufen: kein install_watcher (läuft als root ohne sudo-Rückfrage), nur Container anpassen.
      [ -f data/docker-compose.slots.yml ] || exit 0
      compose up -d --remove-orphans
      exit 0
    fi
    ensure_slots || { echo "Konnte data/docker-compose.slots.yml nicht erzeugen (cloudy logs cloudy)."; exit 1; }
    install_watcher
    compose up -d --remove-orphans
    compose ps
    echo "WARP-/VPN-Container sind an die Profile im Dashboard angepasst. Zustand: cloudy status"
    ;;
  dhcp)
    case "${2:-}" in
      an|on)
        echo "Wichtig: In der Fritzbox muss der DHCP-Server AUS sein"
        echo "(Heimnetz → Netzwerk → Netzwerkeinstellungen → IPv4 → Haken bei 'DHCP-Server aktivieren' entfernen)."
        ask "Ist der DHCP-Server der Fritzbox ausgeschaltet?" || { echo "Abgebrochen."; exit 1; }
        set_env DHCP_ENABLED 1
        compose up -d
        echo "Der Pi verteilt jetzt die IP-Adressen. Geräte kurz WLAN aus/an schalten, damit sie es sofort merken."
        ;;
      aus|off)
        set_env DHCP_ENABLED 0
        set_env GATEWAY_ENABLED 0
        compose up -d
        echo "Der Pi verteilt keine IP-Adressen mehr."
        echo "Jetzt in der Fritzbox den DHCP-Server wieder einschalten und 'Lokaler DNS-Server' zurückstellen."
        ;;
      *) usage; exit 1 ;;
    esac
    ;;
  gateway)
    case "${2:-}" in
      an|on)
        if ! grep -q "^DHCP_ENABLED=1" .env; then
          echo "Zuerst 'cloudy dhcp an' – nur dann bekommen die Geräte den Pi als Gateway."
          exit 1
        fi
        echo "Danach läuft der gesamte Internetverkehr über den Pi (Pi 3B+: max. ca. 150 Mbit/s für alle zusammen)."
        echo "DNS-Force: Auch fest eingestellte DNS-Server (z. B. 8.8.8.8) werden auf den Pi umgeleitet – nichts an den Geräten ändern."
        echo "Geräte mit Portfreigabe vorher in ~/cloudy/data/dhcp-hosts.conf mit 'set:direkt' eintragen."
        ask "Gateway einschalten?" || { echo "Abgebrochen."; exit 1; }
        set_env GATEWAY_ENABLED 1
        compose up -d
        echo "Gateway ist an (inkl. DNS-Force). Geräte kurz WLAN aus/an schalten, damit sie es sofort übernehmen."
        ;;
      aus|off)
        set_env GATEWAY_ENABLED 0
        compose up -d
        echo "Gateway ist aus. Geräte gehen nach dem nächsten IP-Erneuern (spätestens 1 Stunde) wieder direkt zur Fritzbox."
        echo "Bis dahin leitet der Pi ihren Verkehr weiter, es fällt also nichts aus."
        ;;
      *) usage; exit 1 ;;
    esac
    ;;
  ipv6)
    case "${2:-}" in
      an|on)
        echo "Voraussetzung: Fritzbox → Heimnetz → Netzwerk → Netzwerkeinstellungen → IPv6"
        echo "→ 'Router Advertisement im LAN aktiv' ausschalten, sonst gibt es zwei IPv6-Router im Heimnetz."
        set_env IPV6_ENABLED 1
        compose up -d
        echo "IPv6 ist an. Geräte kurz WLAN aus/an. Geräte ohne WARP/VPN bleiben bei IPv4 (kein IPv6-Internet ohne Tunnel)."
        echo "Prüfen: cloudy status (zeigt, welche Tunnel IPv6 können) und https://speed.cloudflare.com ('Connected via')."
        ;;
      aus|off)
        set_env IPV6_ENABLED 0
        compose up -d
        echo "IPv6 ist aus: Alles läuft über IPv4 durch den Pi (Fritzbox: 'Router Advertisement' bleibt am besten aus)."
        ;;
      *) usage; exit 1 ;;
    esac
    ;;
  status)
    compose ps -a
    if [ -f data/docker-compose.slots.yml ]; then
      echo "Profile (data/docker-compose.slots.yml): $(grep -oE '^  (warp|vpn)[0-9]+' data/docker-compose.slots.yml | tr -d ' ' | tr '\n' ' ')"
    else
      echo "Profile: data/docker-compose.slots.yml FEHLT -> cloudy slots"
    fi
    grep -E "^(PI_IP|DHCP_ENABLED|GATEWAY_ENABLED|IPV6_ENABLED|UPSTREAM_DNS|WARP_KILLSWITCH)=" .env
    for f in data/warp/*/status; do
      [ -f "$f" ] && echo "WARP $(basename "$(dirname "$f")"): $(cat "$f")"
    done
    for f in data/warp/*/ipv6; do
      [ -f "$f" ] && echo "IPv6 im Tunnel $(basename "$(dirname "$f")"): $(cat "$f")"
    done
    ;;
  logs) compose logs -f --tail 100 ${2:+"$2"} ;;
  restart) compose restart ;;
  *) usage ;;
esac
