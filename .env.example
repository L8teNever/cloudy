# --- Netzwerk ---
# Feste IP des Raspberry Pi (muss AUSSERHALB des DHCP-Bereichs liegen).
PI_IP=192.168.178.2
# IP der Fritzbox (bleibt das Gateway ins Internet).
ROUTER_IP=192.168.178.1
NETMASK=255.255.255.0
LAN_INTERFACE=eth0
# Wohin der Pi DNS-Anfragen weiterreicht (mehrere mit Komma trennen).
UPSTREAM_DNS=172.64.36.1

# --- IP-Verteilung (DHCP) ---
# Erst auf 1 stellen, wenn in der Fritzbox der DHCP-Server AUS ist!  Am einfachsten: `cloudy dhcp an`
DHCP_ENABLED=0
DHCP_START=192.168.178.20
DHCP_END=192.168.178.200
DHCP_LEASE=30d

# --- Gateway (gesamter Datenverkehr über den Pi) ---
# Braucht DHCP_ENABLED=1. Am einfachsten: `cloudy gateway an`
GATEWAY_ENABLED=0
TRAFFIC_POLL_SECONDS=10

# --- Dashboard ---
DASHBOARD_PORT=80
# Name des Dashboards im Heimnetz (http://cloudy.lan). Leer = kein Name. Nicht .local und keine echte Domain benutzen.
LOCAL_NAME=cloudy.lan
# HTTPS mit eigenem Zertifikat (https://cloudy.lan). Leer oder 0 = aus. CA-Zertifikat: http://cloudy.lan/ca.crt
HTTPS_PORT=443
# Optional: Passwort fürs Dashboard (Benutzername egal). Leer = kein Passwort.
DASHBOARD_PASSWORD=
# Wie viele Einzel-Aufrufe gespeichert werden und wie lange die Statistik pro Gerät bleibt.
MAX_ROWS=50000
RETENTION_DAYS=30

# --- IPv6 über den Pi (cloudy ipv6 an) ---
# 1 = Der Pi verteilt IPv6 im Heimnetz (eigenes privates Netz) und schickt es durch WARP/VPN. Nur mit GATEWAY_ENABLED=1
#     und nur, wenn die Fritzbox "Router Advertisement im LAN aktiv" AUS hat. 0 = nur IPv4 (Standard).
IPV6_ENABLED=0
# Optional: eigenes privates /64 (fd00::/8), z. B. fd12:3456:789a:1::/64. Leer = wird einmal zufällig erzeugt und gespeichert.
IPV6_PREFIX=

# --- Cloudflare WARP & VPN (pro Gerät, im Dashboard einstellen) ---
# 1 = Geräte mit WARP/VPN haben KEIN Internet, wenn der Tunnel weg ist. 0 = sie gehen dann normal über die Fritzbox.
WARP_KILLSWITCH=0

# --- Fernzugriff (Cloudflare Tunnel, z. B. https://cloudy.kulbarts.com) ---
# Wird im Dashboard eingerichtet: Einstellungen → Fernzugriff (Token, Team-Domain, AUD). Hier nichts eintragen.
# Absender-IP des Tunnel-Containers (docker-compose.yml). Anfragen von dort brauchen immer eine Cloudflare-Anmeldung.
TUNNEL_IP=172.29.88.10
