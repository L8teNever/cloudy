# Optional: Passwort fürs Dashboard (HTTP-Basic-Auth, beliebiger Benutzername). Leer = kein Passwort.
DASHBOARD_PASSWORD=
# 1 nur setzen, wenn ein Reverse-Proxy davorsteht (dann wird X-Forwarded-For als Client-IP benutzt).
TRUST_PROXY=0
# So viele Einträge werden maximal gespeichert.
MAX_ROWS=10000
